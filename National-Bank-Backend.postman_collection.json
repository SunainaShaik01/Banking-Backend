              "raw": "{\n  \"type\": \"Credit Card\",\n  \"amount\": 5000.00,\n  \"interestRate\": 18.50,\n  \"minPayment\": 150.00,\n  \"additionalPayment\": 50.00,\n  \"userId\": {{userId}}\n}"
