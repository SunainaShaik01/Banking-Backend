{
  "info": {
    "name": "National Bank Backend",
    "description": "API collection for the National Bank Spring Boot backend.\n\n1. Run **Auth → Login** first to store the JWT token and user ID.\n2. Protected requests use Bearer auth automatically.\n3. Adjust `baseUrl`, `userId`, and `budgetId` in collection variables as needed.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "userId",
      "value": "2"
    },
    {
      "key": "budgetId",
      "value": "1"
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"John\",\n  \"lastName\": \"Doe\",\n  \"email\": \"john.doe@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/users/register",
              "host": ["{{baseUrl}}"],
              "path": ["users", "register"]
            },
            "description": "Register a new user account."
          },
          "response": []
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const json = pm.response.json();",
                  "    if (json.token) {",
                  "        pm.collectionVariables.set('token', json.token);",
                  "    }",
                  "    if (json.userId) {",
                  "        pm.collectionVariables.set('userId', String(json.userId));",
                  "    }",
                  "    pm.test('Login successful', function () {",
                  "        pm.expect(json.token).to.be.a('string').and.not.empty;",
                  "    });",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@bank.com\",\n  \"password\": \"user123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/users/login",
              "host": ["{{baseUrl}}"],
              "path": ["users", "login"]
            },
            "description": "Login with seed user credentials. Saves JWT token and userId to collection variables."
          },
          "response": []
        },
        {
          "name": "Login (Admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const json = pm.response.json();",
                  "    if (json.token) {",
                  "        pm.collectionVariables.set('token', json.token);",
                  "    }",
                  "    if (json.userId) {",
                  "        pm.collectionVariables.set('userId', String(json.userId));",
                  "    }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@bank.com\",\n  \"password\": \"admin123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/users/login",
              "host": ["{{baseUrl}}"],
              "path": ["users", "login"]
            },
            "description": "Login as admin user."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Transactions",
      "item": [
        {
          "name": "Deposit",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": {{userId}},\n  \"amount\": 100.00\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/transaction/deposit",
              "host": ["{{baseUrl}}"],
              "path": ["api", "transaction", "deposit"]
            },
            "description": "Deposit funds into a user account."
          },
          "response": []
        },
        {
          "name": "Withdraw",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": {{userId}},\n  \"amount\": 50.00\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/transaction/withdraw",
              "host": ["{{baseUrl}}"],
              "path": ["api", "transaction", "withdraw"]
            },
            "description": "Withdraw funds from a user account."
          },
          "response": []
        },
        {
          "name": "Get Balance",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/transaction/balance/{{userId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "transaction", "balance", "{{userId}}"]
            },
            "description": "Get the current balance for a user."
          },
          "response": []
        },
        {
          "name": "Get Transaction History",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/transaction/history/{{userId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "transaction", "history", "{{userId}}"]
            },
            "description": "Get transaction history for a user."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Expenses",
      "item": [
        {
          "name": "Get Expenses by Date",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/{{userId}}/expense?date=2026-07-23",
              "host": ["{{baseUrl}}"],
              "path": ["api", "{{userId}}", "expense"],
              "query": [
                {
                  "key": "date",
                  "value": "2026-07-23",
                  "description": "ISO date (YYYY-MM-DD)"
                }
              ]
            },
            "description": "Get expenses for a specific date."
          },
          "response": []
        },
        {
          "name": "Save Expenses",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "[\n  {\n    \"expenseDate\": \"2026-07-23\",\n    \"category\": \"Groceries\",\n    \"amount\": 75.50\n  },\n  {\n    \"expenseDate\": \"2026-07-23\",\n    \"category\": \"Utilities\",\n    \"amount\": 120.00\n  }\n]"
            },
            "url": {
              "raw": "{{baseUrl}}/api/{{userId}}/expense",
              "host": ["{{baseUrl}}"],
              "path": ["api", "{{userId}}", "expense"]
            },
            "description": "Create or update expenses for a user."
          },
          "response": []
