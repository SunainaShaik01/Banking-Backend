        {
          "name": "Get Expense Dashboard",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/{{userId}}/expense/dashboard?month=7",
              "host": ["{{baseUrl}}"],
              "path": ["api", "{{userId}}", "expense", "dashboard"],
              "query": [
                {
                  "key": "month",
                  "value": "7",
                  "description": "Month number (1-12)"
                }
              ]
            },
            "description": "Get monthly expense dashboard summary."
          },
          "response": []
        },
        {
          "name": "Get Expense Trends",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/{{userId}}/expense/trends",
              "host": ["{{baseUrl}}"],
              "path": ["api", "{{userId}}", "expense", "trends"]
            },
            "description": "Get expense trend data for a user."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Debts",
