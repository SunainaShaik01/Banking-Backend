      ]
    },
    {
      "name": "Budgets",
      "item": [
        {
          "name": "Create Budget",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const json = pm.response.json();",
                  "    if (json.id) {",
                  "        pm.collectionVariables.set('budgetId', String(json.id));",
                  "    }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": {{userId}},\n  \"month\": 7,\n  \"year\": 2026\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/budget",
              "host": ["{{baseUrl}}"],
              "path": ["api", "budget"]
            },
            "description": "Create a budget for a month. Saves budgetId to collection variables."
          },
          "response": []
        },
